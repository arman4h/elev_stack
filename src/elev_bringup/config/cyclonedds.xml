<?xml version="1.0" encoding="UTF-8" ?>
<!-- CycloneDDS for Jetson <-> laptop rviz2. Both machines need the same ROS_DOMAIN_ID.
     Set NetworkInterfaceAddress to the Jetson's WLAN/LAN interface if auto picks the lidar port
     (192.168.1.5), which the lidar may not share with DDS traffic. -->
<CycloneDDS xmlns="https://cdds.io/config" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Domain id="any">
    <General>
      <NetworkInterfaceAddress>auto</NetworkInterfaceAddress>
      <AllowMulticast>default</AllowMulticast>
    </General>
  </Domain>
</CycloneDDS>
